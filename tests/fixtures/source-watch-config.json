{
  "version": 1,
  "policy": {
    "transient_http_statuses": [
      429,
      500,
      503
    ],
    "permanent_http_statuses": [
      404,
      410
    ],
    "min_text_chars": 20
  },
  "sources": [
    {
      "id": "demo-source",
      "url": "https://example.com/help",
      "questions": [
        "QTEST"
      ],
      "anchor_groups": [
        [
          "scheduled tasks",
          "recurring tasks"
        ],
        [
          "citations",
          "source links"
        ]
      ],
      "fetch_mode": "direct"
    },
    {
      "id": "manual-demo",
      "url": "https://example.com/manual",
      "questions": [
        "QMANUAL"
      ],
      "fetch_mode": "manual",
      "manual_reason": "Fixture verifies that manual sources do not require network content.",
      "anchor_groups": [
        [
          "manual anchor"
        ]
      ]
    }
  ]
}
