{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Josh-Temple/can-ai-do-this/schemas/question.schema.json",
  "title": "Can AI Do This question record",
  "type": "object",
  "required": [
    "id",
    "question",
    "slug",
    "category",
    "status",
    "last_checked",
    "answers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Q[0-9]{4,}$"
    },
    "question": {
      "type": "string",
      "minLength": 5
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "REVIEW_REQUIRED"
      ]
    },
    "demand": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "community_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "observed_at"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "observed_at": {
                "type": "string",
                "format": "date"
              },
              "summary": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "summary_ja": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "product",
          "answer",
          "evidence_state",
          "last_checked",
          "sources"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "plan": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "answer": {
            "enum": [
              "YES",
              "PARTIAL",
              "NO",
              "UNKNOWN"
            ]
          },
          "summary": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_state": {
            "enum": [
              "VERIFIED",
              "DOCUMENTED",
              "USER_REPORTED",
              "STALE"
            ]
          },
          "last_checked": {
            "type": "string",
            "format": "date"
          },
          "tested_environment": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "account_tier": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "app": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "url",
                "accessed_at"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "OFFICIAL_DOC",
                    "OFFICIAL_ANNOUNCEMENT",
                    "DIRECT_TEST",
                    "SECONDARY",
                    "COMMUNITY"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "accessed_at": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "summary_ja": {
            "type": "string"
          },
          "conditions_ja": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations_ja": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "question_ja": {
      "type": "string",
      "minLength": 2
    },
    "notes_ja": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
